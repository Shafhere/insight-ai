# AI provider
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Portal authentication (change both before deployment)
INSIGHT_ADMIN_EMAIL=admin@insight.ai
INSIGHT_ADMIN_PASSWORD=ChangeMe123!
INSIGHT_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Local development defaults. Docker Compose overrides DATABASE_URL and REDIS_URL.
DATABASE_URL=sqlite:///./storage/insight_portal.sqlite3
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
