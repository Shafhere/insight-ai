# AI provider
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Portal authentication (change both before deployment)
INSIGHT_ADMIN_EMAIL=admin@insight.ai
INSIGHT_ADMIN_PASSWORD=
INSIGHT_AUTH_SECRET=

# Local development defaults. Docker Compose overrides DATABASE_URL and REDIS_URL.
DATABASE_URL=sqlite:///./storage/insight_portal.sqlite3
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:5173

# Optional MiniLM / Chroma index; the offline hybrid mode is the default.
SEMANTIC_EMBEDDINGS=false
